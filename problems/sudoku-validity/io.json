        "label": "r",
        "note": "row, 0-indexed, 0-8"
      },
      {
        "of": "int",
        "label": "c",
        "note": "column, 0-indexed, 0-8"
      },
      {
        "of": "int",
        "label": "v",
        "note": "value placed at (r, c), 1-9"
      }
    ]
  },
  "output": {
    "of": "int",
    "label": "verdict",
    "note": "1 if consistent so far, else 0"
