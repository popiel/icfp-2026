[0] = input
bp = [0]
[1] = 8
loop1:
[[1]] = input
[1] = [1] + 1
m if_bp goto loop1

[1] = [0] + 8
[2] = 8
loop2:
[2] = [2] + 1
if [2] - [1] == 0 goto exit
# B == [2]
[4] = [[2]]
[3] = [2]
# B = [3]
loop3:
if [3] - 8 <= 0 goto n2
[5] = [[3] - 1]
if [5] - [4] <= 0 goto n2
[[3]] = [5]
[3] = [3] - 1
goto loop3

n2:
[[3]] = [4]
goto loop2

exit:
bp = [0]
[1] = 8
loop4:
output [[1]]
[1] = [1] + 1
m if_bp goto loop4



